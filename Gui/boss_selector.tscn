[sub_resource type="GDScript" id="GDScript_qpsvo"]
script/source = "@tool
extends TextureButton


func _process(_delta: float) -> void:
	custom_minimum_size = Vector2(size.y/2,custom_minimum_size.y)
	if !Engine.is_editor_hint() && $\"..\".name == \"SelecterBossContainer\": disabled = $\"..\".index_ <= 0
"

[sub_resource type="GDScript" id="GDScript_2vxfp"]
script/source = "@tool
extends TextureButton


func _process(_delta: float) -> void:
	custom_minimum_size = Vector2(size.y/2,custom_minimum_size.y)
	if !Engine.is_editor_hint() && $\"..\".name == \"SelecterBossContainer\": disabled = $\"..\".index_ >= $\"..\".boss_list.size()-1
"

