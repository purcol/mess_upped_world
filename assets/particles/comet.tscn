[sub_resource type="GDScript" id="GDScript_pnrrj"]
script/source = "extends Button

func _toggled(_toggled_on: bool) -> void:
	disabled = true
	$\"../CometPoly\".visible = false
	$\"..\".velosity = Vector2(0,0)
	$\"..\".emitting = false
	$\"../CometParticle\".emitting = false
	$\"../CometParticle2\".emitting = false
	$\"../CometParticle3\".emitting = true
	await get_tree().create_timer(0.5).timeout
	$\"../CometParticle3\".emitting = false
	GSaves.star_count += 1
	#$\"../Timer\".time_left = 2
"

