[sub_resource type="GDScript" id="GDScript_x3ktt"]
script/source = "@tool
extends CPUParticles2D

@export var SPEED:float = 30.0
@export var velosity:Vector2 = Vector2(80,120)
var offset:Vector2 = Vector2(0,0)
var spawn_pos:Vector2

func _ready() -> void:
	if Engine.is_editor_hint(): return
	spawn_pos = global_position
	var rand:Vector2 = abs(velosity*randf_range(-2,2))
	SPEED += rand.length()*0.25
	velosity += rand
	if randi_range(0,1) == 1:
		modulate = Color(\"#cecfe1\")

func _process(delta: float) -> void:
	if rotation_degrees >= 360:
		rotation_degrees -= 360
	
	var comet_size:float = randf_range(6,12)
	$CometPoly.polygon = PackedVector2Array([
		Vector2(-comet_size,-comet_size),
		Vector2(comet_size,-comet_size),
		Vector2(comet_size,comet_size),
		Vector2(-comet_size,comet_size)
	])
	rotation_degrees += SPEED*delta
	if Engine.is_editor_hint(): return
	offset += velosity*delta
	global_position = offset+spawn_pos


func _on_timer_timeout() -> void:
	queue_free()
"

