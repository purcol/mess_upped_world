[sub_resource type="GDScript" id="GDScript_i8scl"]
script/source = "extends LineEdit


func _ready() -> void:
	if GWeapons.is_active($\"../../../..\".WEAPON): text = \"Акстивное\"
	else: text = \"Пасивное\"
"

