[sub_resource type="GDScript" id="GDScript_ru0r1"]
script/source = "extends Button

@export_enum(\"SHOTER\",\"CHARGER_SHOTER\",\"SHOTERS_SHOTER\",\"LAZER\",\"LAZER_MINE\") var WEAPON = 0

func _process(_delta: float) -> void:
	if Engine.is_editor_hint(): return
	
	if GWeapons.is_equiped(WEAPON): text = \"Снять\"
	else: text = \"Экипировать\"
	
	$Cursor.visible = is_hovered()

func _toggled(_toggled_on: bool) -> void:
	GWeapons.toggle_weapon(WEAPON)
"

[sub_resource type="GDScript" id="GDScript_ugce8"]
script/source = "extends Polygon2D

var full_poly


func _ready() -> void:
	full_poly = polygon
	while true:
		await get_tree().create_timer(0.3).timeout
		polygon = full_poly
		await get_tree().create_timer(0.3).timeout
		polygon = PackedVector2Array([Vector2(0,0)])
"

