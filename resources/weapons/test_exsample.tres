script = ExtResource("1_8m2ms")
name = &"Title"
ru_name = &"Название"
desc = "Normal [5]lazer[/5], nothing [5]spacial[/5].
[1]Although[/1], I need to make a [4]mini-game[/4] for it."
ru_desc = "Обычный [5]ресурс[/5], ничего  
необычного. Хотя ему  
надо будет придумать   
мини-игру. У этого     
оружия очень длинное и  
бесполезное описание  
для проверки работы    
прокрутки. Меня пугает  
кол-во работы, а это  
же только интерфейс!   
Возможно, возможно у   
меня больше амбиции, ну 
да и ладно меня уже    
удовлетворяет         
результат
        -Я"
metadata/_custom_type_script = "uid://dnomfoc530vgc"
