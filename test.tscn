[sub_resource type="GDScript" id="GDScript_ppyta"]
script/source = "extends TextEdit

var timer = 0

# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	pass # Replace with function body.


# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(_delta: float) -> void:
	if timer < 10:
		text = $\"../MonitorCLI\".text
	timer += 1


func _on_resized() -> void:
	pass # Replace with function body.
"

[sub_resource type="GDScript" id="GDScript_ykrsh"]
script/source = "@tool
extends LineEdit

func _process(_delta: float) -> void:
	text = str(Engine.get_frames_per_second())
"

[sub_resource type="StyleBoxEmpty" id="StyleBoxEmpty_xersf"]

[sub_resource type="GDScript" id="GDScript_vbegm"]
script/source = "extends Button


func _pressed() -> void:
	$\"../MiniGameFlappyBird\".is_paused = !$\"../MiniGameFlappyBird\".is_paused
	text = str($\"../MiniGameFlappyBird\".is_paused)

func _process(_delta: float) -> void:
	text = str($\"../MiniGameFlappyBird\".is_paused)+\" \"+$\"../MiniGameFlappyBird\".get_char_from_text(Vector2i(1,1))
"

[sub_resource type="StyleBoxEmpty" id="StyleBoxEmpty_00tp4"]

[sub_resource type="GDScript" id="GDScript_i7x8i"]
script/source = "extends Camera2D


# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	pass # Replace with function body.


# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(_delta: float) -> void:
	if Input.is_key_pressed(KEY_W):
		position.y -= 6
	if Input.is_key_pressed(KEY_S):
		position.y += 6
	if Input.is_key_pressed(KEY_A):
		position.x -= 6
	if Input.is_key_pressed(KEY_D):
		position.x += 6
"

